<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: strip www -> apex (platform already enforces HTTPS). Loop-safe.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Pretty URLs (before directory check so /blog doesn't resolve to blog/ dir)
  RewriteRule ^blog/?$ blog.html [L]
  RewriteCond %{REQUEST_URI} !\.html$
  RewriteRule ^blog/([a-z0-9-]+)/?$ blog/$1.html [L]

  # Service areas (before directory check so /service-areas doesn't resolve to the dir)
  RewriteRule ^service-areas/?$ service-areas.html [L]
  RewriteCond %{REQUEST_URI} !\.html$
  RewriteRule ^service-areas/([a-z0-9-]+)/?$ service-areas/$1.html [L]

  # Don't rewrite existing files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Exclude subdirectories from rewrite
  RewriteRule ^projectworks/ - [L]
  RewriteRule ^api/ - [L]
  RewriteRule ^img/ - [L]
  RewriteRule ^uploads/ - [L]
  RewriteRule ^includes/ - [L]

  # Campaign landing pages (/lp/roofing -> lp/roofing.html); trailing slash OK
  RewriteRule ^lp/([a-z0-9-]+)/?$ lp/$1.html [L]

  # Pretty URLs for pages (trailing slash optional)
  RewriteRule ^general-contractor-knoxville/?$ general-contractor-knoxville.html [L]
  RewriteRule ^cost-calculator/?$ cost-calculator.html [L]
  RewriteRule ^thank-you/?$ thank-you.html [L]
  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^gallery/?$ gallery.html [L]
  RewriteRule ^services/?$ services.html [L]
  RewriteRule ^contact/?$ contact.html [L]
  RewriteRule ^roofing/?$ roofing.html [L]
  RewriteRule ^exteriors/?$ exteriors.html [L]
  RewriteRule ^roofing-knoxville/?$ roofing-knoxville.html [L]
  RewriteRule ^roofing-farragut/?$ roofing-farragut.html [L]
  RewriteRule ^roofing-maryville/?$ roofing-maryville.html [L]
  RewriteRule ^roofing-oak-ridge/?$ roofing-oak-ridge.html [L]
  RewriteRule ^roofing-lenoir-city/?$ roofing-lenoir-city.html [L]
  RewriteRule ^roofing-sevierville/?$ roofing-sevierville.html [L]
  RewriteRule ^decks/?$ decks.html [L]
  RewriteRule ^financing/?$ financing.html [L]
  RewriteRule ^agentworks/?$ agentworks.html [L]
  RewriteRule ^agent-login/?$ agent-login.html [L]
  RewriteRule ^agent-dashboard/?$ agent-dashboard.html [L]
  RewriteRule ^agent-admin/?$ agent-admin.html [L]
  RewriteRule ^agent-submit/?$ agent-submit.html [L]
</IfModule>

# Custom 404
ErrorDocument 404 /404.html

# Correct MIME types (Hostinger serves .avif as text/plain by default, which
# nosniff then blocks from rendering — this fixes AVIF + webmanifest).
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML must always revalidate or a deploy is invisible to returning visitors.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Compression (text assets only; images are already compressed)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE application/json application/xml text/xml
  AddOutputFilterByType DEFLATE image/svg+xml text/plain
</IfModule>

# Safe security headers (no HSTS/includeSubDomains — avoids affecting app. subdomain)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS without includeSubDomains (keeps the app. subdomain unaffected).
  Header always set Strict-Transport-Security "max-age=31536000"
  # Baseline CSP: permissive for scripts/connections (site uses inline + GA/Meta/
  # chat over https) but locks down object/base/frame + upgrades insecure refs.
  Header always set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # The service worker must always revalidate so SW updates ship immediately.
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # Same for pages. Extensionless URLs (/about) are internally rewritten to
  # .html, so this FilesMatch covers them too.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
